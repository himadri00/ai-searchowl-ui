# Clerk sign-in. Get both keys from dashboard.clerk.com -> your app -> API keys.
# Without them the app runs in preview mode (pages stay open) and /sign-in
# shows these setup steps. Restart the dev server after editing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Backend API. The organization, workspace, and brand are NOT set here:
# the org comes from the signed-in Clerk user (or their active Clerk
# organization), and the workspace and brand come from the switcher.
# API_KEY stays on the server and is never sent to the browser.
API_BASE_URL=http://127.0.0.1:8000
API_KEY=
